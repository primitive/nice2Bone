{
  "name": "nice2b",
  "version": "2.0.1",
  "description": "Headless WordPress Blog theme with Infinite Scroll. React based SPA, CSR only (not SEO friendly).",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "dev": "dotenvx run -- webpack --watch --mode=development",
    "start": "babel-node src/app.js",
    "serve": "nodemon --exec npm start",
    "test": "eslint src/ && echo 'Lint passed!'",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,scss,md}\""
  },
  "keywords": [
    "headless",
    "wordpress",
    "blog",
    "theme",
    "decoupled",
    "rest-api",
    "react",
    "spa",
    "csr"
  ],
  "author": "primitiveshaun",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/primitive/nice2bone.git"
  },
  "dependencies": {
    "@babel/runtime-corejs2": "^7.27.1",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "bootstrap": "^5.3.7",
    "he": "^1.2.0",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-ga4": "^2.1.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.5.3",
    "react-spinners": "^0.15.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.1",
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/node": "^7.27.1",
    "@babel/plugin-proposal-decorators": "^7.27.1",
    "@babel/plugin-proposal-do-expressions": "^7.27.1",
    "@babel/plugin-proposal-export-default-from": "^7.27.1",
    "@babel/plugin-proposal-function-bind": "^7.27.1",
    "@babel/plugin-proposal-function-sent": "^7.27.1",
    "@babel/plugin-proposal-pipeline-operator": "^7.27.1",
    "@babel/plugin-proposal-throw-expressions": "^7.27.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-export-namespace-from": "^7.27.0",
    "@babel/plugin-transform-json-strings": "^7.27.0",
    "@babel/plugin-transform-logical-assignment-operators": "^7.27.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "^7.27.0",
    "@babel/plugin-transform-numeric-separator": "^7.27.0",
    "@babel/plugin-transform-optional-chaining": "^7.27.0",
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@dotenvx/dotenvx": "^1.43.0",
    "@emotion/core": "^11.0.0",
    "babel-loader": "^10.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "image-webpack-loader": "^8.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-shell-plugin-next": "^2.3.2"
  },
  "type": "module"
}
